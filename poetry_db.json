    {
      "id": "p-2",
      "poetId": "poet-elia",
      "poetNameUrdu": "جون ایلیا",
      "poetNameEnglish": "Jaun Elia",
      "categoryId": "cat-elia",
      "poetryType": "ashar",
      "versesUrdu": [
        "شاید مجھے کسی سے محبت نہیں ہوئی",
        "لیکن یقین سب کو دلاتا رہا ہوں میں"
      ],
      "status": "published",
      "likesCount": 189,
      "featured": true,
      "createdAt": "2026-01-11T12:30:00.000Z"
    },
    {
      "id": "p-elia-ghazal-1",
      "poetId": "poet-elia",
      "poetNameUrdu": "جون ایلیا",
      "poetNameEnglish": "Jaun Elia",
      "categoryId": "cat-elia",
      "poetryType": "ghazal",
      "versesUrdu": [
        "بے دلی کیا یوں ہی دن گزر جائیں گے",
        "صرف زندہ رہے ہم تو مر جائیں گے",
        "رقص ہے رنگ پر رنگ ہم رقص ہیں",
        "سب بچھڑ جائیں گے سب بکھر جائیں گے",
        "کتنی دلکش ہو تم کتنا دل جو ہوں میں",
