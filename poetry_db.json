  "poetry": [
    {
      "id": "p-1789330808078-ycbi",
      "poetId": "poet-iqbal",
      "poetNameUrdu": "علامہ اقبال",
      "poetNameEnglish": "Allama Iqbal",
      "categoryId": "cat-ishq",
      "versesUrdu": [
        "خودی کو کر بلند اتنا کہ ہر تقدیر سے پہلے",
        "خدا بندے سے خود پوچھے بتا تیری رضا کیا ہے"
      ],
      "poetryType": "kalam",
      "status": "published",
      "likesCount": 0,
      "featured": false,
      "createdAt": "2026-09-13T20:20:08.078Z"
    },
    {
      "id": "p-1",
      "poetId": "poet-ghalib",
      "poetNameUrdu": "مرزا اسد اللہ خاں غالب",
      "poetNameEnglish": "Mirza Ghalib",
      "categoryId": "cat-ghalib",
      "poetryType": "ashar",
      "versesUrdu": [
        "ہزاروں خواہشیں ایسی کہ ہر خواہش پہ دم نکلے",
        "بہت نکلے مرے ارمان لیکن پھر بھی کم نکلے"
      ],
      "status": "published",
      "likesCount": 142,
      "featured": true,
      "createdAt": "2026-01-10T10:00:00.000Z"
    },
    {
      "id": "p-ghalib-ghazal-1",
      "poetId": "poet-ghalib",
      "poetNameUrdu": "مرزا اسد اللہ خاں غالب",
      "poetNameEnglish": "Mirza Ghalib",
      "categoryId": "cat-ghalib",
      "poetryType": "ghazal",
      "versesUrdu": [
        "دلِ ناداں تجھے ہوا کیا ہے",
        "آخر اس درد کی دوا کیا ہے",
        "ہم ہیں مشتاق اور وہ بیزار",
        "یا الٰہی یہ ماجرا کیا ہے",
        "میں بھی منہ میں زبان رکھتا ہوں",
        "کاش پوچھو کہ مدعا کیا ہے",
        "ہم کو ان سے وفا کی ہے امید",
        "جو نہیں جانتے وفا کیا ہے",
        "جان تم پر نثار کرتا ہوں",
        "میں نہیں جانتا دعا کیا ہے"
      ],
      "status": "published",
      "likesCount": 320,
      "featured": true,
      "createdAt": "2026-01-25T12:00:00.000Z"
    },
    {
      "id": "p-1b",
      "poetId": "poet-ghalib",
      "poetNameUrdu": "مرزا اسد اللہ خاں غالب",
      "poetNameEnglish": "Mirza Ghalib",
      "categoryId": "cat-ishq",
      "poetryType": "ashar",
      "versesUrdu": [
